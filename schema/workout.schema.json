{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WILO workout",
  "description": "A doc in users/{uid}/assigned or users/{uid}/completed. Lists only the fields every existing doc has; extra fields are allowed.",
  "type": "object",
  "required": ["id", "name", "exercises"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["instanceId", "exId", "name", "timed", "cue", "custom_name", "fallback", "swapped", "sets"],
        "properties": {
          "instanceId": { "type": "string" },
          "exId": { "type": "string" },
          "name": { "type": "string" },
          "timed": { "type": "boolean" },
          "cue": { "type": "string" },
          "custom_name": { "type": ["string", "null"] },
          "fallback": { "type": ["object", "null"] },
          "swapped": { "type": "boolean" },
          "sets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["lbs", "reps", "done", "custom"],
              "properties": {
                "lbs": { "type": ["number", "string"], "pattern": "^$", "minimum": 0 },
                "reps": { "type": ["number", "string"], "pattern": "^$", "minimum": 0 },
                "done": { "type": "boolean" },
                "custom": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
